<?xml version="1.0" encoding="utf-8"?>
<!-- A06 Đăng nhập. Bọc trong ScrollView để máy màn hình nhỏ hoặc khi bàn phím mở vẫn cuộn xem hết được. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <!-- Logo: ô vuông bo góc màu chính, ghim bản đồ màu trắng -->
        <ImageView
            android:id="@+id/logoIV"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/bg_a06_logo"
            android:contentDescription="@string/a06_logo"
            android:padding="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_place"
            app:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/tieuDeTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/a06_tieu_de"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logoIV" />

        <TextView
            android:id="@+id/moTaTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/a06_mo_ta"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tieuDeTV" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailTIL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:hint="@string/a06_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moTaTV">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                tools:text="an@datour.test" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- endIconMode="password_toggle": biểu tượng con mắt để hiện / ẩn mật khẩu -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/matKhauTIL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/a06_mat_khau"
            app:endIconMode="password_toggle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailTIL">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/matKhauET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                tools:text="12345678" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/quenMatKhauTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:text="@string/a06_quen_mat_khau"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/matKhauTIL" />

        <Button
            android:id="@+id/dangNhapBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/a06_dang_nhap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quenMatKhauTV" />

        <!-- Dòng "hoặc": chữ ở giữa, hai đường kẻ hai bên -->
        <TextView
            android:id="@+id/hoacTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:text="@string/a06_hoac"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dangNhapBtn" />

        <View
            android:id="@+id/keTraiV"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintBottom_toBottomOf="@+id/hoacTV"
            app:layout_constraintEnd_toStartOf="@+id/hoacTV"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/hoacTV" />

        <View
            android:id="@+id/kePhaiV"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintBottom_toBottomOf="@+id/hoacTV"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hoacTV"
            app:layout_constraintTop_toTopOf="@+id/hoacTV" />

        <Button
            android:id="@+id/vanTayBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/a06_dang_nhap_van_tay"
            app:icon="@drawable/ic_fingerprint"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hoacTV" />

        <!-- "Chưa có tài khoản? Đăng ký" -->
        <LinearLayout
            android:id="@+id/dangKyLL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vanTayBtn">

            <TextView
                android:id="@+id/chuaCoTaiKhoanTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/a06_chua_co_tai_khoan"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/dangKyTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:text="@string/a06_dang_ky"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/xemTourTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/a06_xem_tour"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dangKyLL" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
