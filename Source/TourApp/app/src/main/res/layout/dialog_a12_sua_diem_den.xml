<?xml version="1.0" encoding="utf-8"?>
<!-- A12 Sửa điểm đến. Trong Figma đây là bảng trượt từ dưới lên;
     giai đoạn này dựng thành một màn hình riêng. Bọc ScrollView vì máy nhỏ có thể không đủ chỗ. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_l">

        <TextView
            android:id="@+id/tieuDeTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/a12_sua_tieu_de"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tenTIL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/a12_ten_diem_den"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tieuDeTV">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tenET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tinhNhanTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/a12_tinh_thanh"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tenTIL" />

        <Spinner
            android:id="@+id/tinhSP"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_xs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tinhNhanTV" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/moTaTIL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/a12_mo_ta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tinhSP">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/moTaET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Vị trí trên bản đồ: chữ bên trái, nút viền bên phải -->
        <TextView
            android:id="@+id/viTriNhanTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_s"
            android:text="@string/a12_vi_tri_ban_do"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@+id/chonBanDoBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/moTaTIL" />

        <TextView
            android:id="@+id/toaDoTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="@+id/viTriNhanTV"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viTriNhanTV"
            tools:text="11.9404, 108.4583" />

        <Button
            android:id="@+id/chonBanDoBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/a12_chon_tren_ban_do"
            app:layout_constraintBottom_toBottomOf="@+id/toaDoTV"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viTriNhanTV" />

        <!-- Hai nút cuối căn phải: Hủy (nút chữ) và Lưu (nút chính) -->
        <Button
            android:id="@+id/luuBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:minWidth="88dp"
            android:text="@string/a12_luu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toaDoTV" />

        <Button
            android:id="@+id/huyBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:text="@string/a12_huy"
            app:layout_constraintEnd_toStartOf="@+id/luuBtn"
            app:layout_constraintTop_toTopOf="@+id/luuBtn" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
