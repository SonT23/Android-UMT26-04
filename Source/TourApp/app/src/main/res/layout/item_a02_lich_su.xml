<?xml version="1.0" encoding="utf-8"?>
<!-- B4: một từ khóa trong lịch sử tìm của A02. TimTourFragment tạo chip này bằng layoutInflater.
     Bấm chip thì tìm lại từ đó, bấm dấu x thì xóa từ đó khỏi lịch sử. -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.Chip.Input"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="false"
    app:chipIcon="@drawable/ic_schedule"
    app:chipIconTint="?attr/colorOnSurfaceVariant"
    app:chipIconVisible="true"
    app:closeIconVisible="true"
    tools:text="Đà Lạt" />
