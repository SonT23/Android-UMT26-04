<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ tour nằm ngang: ảnh bên trái, thông tin bên phải. Dùng cho A02 Tìm tour và A21 Yêu thích. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="@dimen/radius_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/anhIV"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_anh_trong"
            android:contentDescription="@string/a01_anh"
            android:padding="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_image"
            app:tint="?attr/colorOutline" />

        <TextView
            android:id="@+id/tenTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@+id/yeuThichIV"
            app:layout_constraintStart_toEndOf="@+id/anhIV"
            app:layout_constraintTop_toTopOf="@+id/anhIV"
            tools:text="Đà Lạt 3 ngày 2 đêm" />

        <TextView
            android:id="@+id/moTaTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="@+id/tenTV"
            app:layout_constraintStart_toStartOf="@+id/tenTV"
            app:layout_constraintTop_toBottomOf="@+id/tenTV"
            tools:text="Đà Lạt · 3 ngày 2 đêm · 20/11" />

        <TextView
            android:id="@+id/giaTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorTertiary"
            app:layout_constraintEnd_toEndOf="@+id/tenTV"
            app:layout_constraintStart_toStartOf="@+id/tenTV"
            app:layout_constraintTop_toBottomOf="@+id/moTaTV"
            tools:text="Từ 2.500.000 ₫" />

        <TextView
            android:id="@+id/nhanTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_nhan"
            android:paddingStart="@dimen/space_s"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="2dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnTertiaryContainer"
            app:layout_constraintStart_toStartOf="@+id/tenTV"
            app:layout_constraintTop_toBottomOf="@+id/giaTV"
            tools:text="Còn 1 chỗ" />

        <ImageView
            android:id="@+id/yeuThichIV"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/a01_yeu_thich"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_favorite_border"
            app:tint="?attr/colorPrimary" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
