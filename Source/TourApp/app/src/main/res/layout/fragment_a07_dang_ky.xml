<?xml version="1.0" encoding="utf-8"?>
<!-- A07 Đăng ký. Form dài nên bọc trong ScrollView. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <!-- Thanh trên: nút quay lại và tiêu đề. Lề âm để mũi tên thẳng hàng với ô nhập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/quayLaiIV"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/a07_quay_lai"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tieuDeTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/a07_tieu_de"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/hoTenTIL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:hint="@string/a07_ho_ten">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hoTenET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                tools:text="Nguyễn Văn An" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailTIL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/a07_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                tools:text="an@datour.test" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- helperText: dòng gợi ý nhỏ dưới ô -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/soDienThoaiTIL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/a07_so_dien_thoai"
            app:helperText="@string/a07_goi_y_so_dien_thoai">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/soDienThoaiET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                tools:text="0912 345 678" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Viền đỏ và dòng báo lỗi được bật trong DangKyFragment bằng matKhauTIL.error.
             errorIconDrawable="@null": khi báo lỗi vẫn giữ biểu tượng con mắt như Figma -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/matKhauTIL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/a07_mat_khau"
            app:endIconMode="password_toggle"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/matKhauET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                tools:text="123456" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nhapLaiTIL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/a07_nhap_lai_mat_khau"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nhapLaiET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/dongYCB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/a07_dong_y_dieu_khoan"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:checked="true" />

        <Button
            android:id="@+id/dangKyBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/a07_dang_ky" />

        <!-- "Đã có tài khoản? Đăng nhập" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/daCoTaiKhoanTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/a07_da_co_tai_khoan"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/dangNhapTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:text="@string/a07_dang_nhap"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
