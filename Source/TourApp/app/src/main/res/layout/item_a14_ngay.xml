<?xml version="1.0" encoding="utf-8"?>
<!-- Một ngày trong lịch trình ở A14: nút kéo, "Ngày 1", tiêu đề ngày, nút tùy chọn -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    app:cardCornerRadius="@dimen/radius_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="@dimen/space_xs">

        <!-- Kéo thả đổi thứ tự (chức năng D5) làm sau, giờ chỉ là biểu tượng -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/a14_keo_doi_thu_tu"
            app:srcCompat="@drawable/ic_drag_handle"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/ngayTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Ngày 1" />

        <TextView
            android:id="@+id/tieuDeTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Khởi hành, nhận phòng" />

        <ImageView
            android:id="@+id/tuyChonIV"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a14_tuy_chon_ngay"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
