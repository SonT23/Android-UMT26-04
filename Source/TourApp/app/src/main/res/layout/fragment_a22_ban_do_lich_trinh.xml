<?xml version="1.0" encoding="utf-8"?>
<!-- A22 Bản đồ lịch trình. Bản đồ thật (Google Maps, chức năng B8) làm ở tuần 9;
     giờ dùng nền xám và vài biểu tượng ghim làm hình giữ chỗ. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Chỗ của bản đồ -->
    <View
        android:id="@+id/banDoV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/banDoTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/a22_ban_do_giu_cho"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOutline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38" />

    <ImageView
        android:id="@+id/tapTrungIV"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/a22_diem_tap_trung"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.30"
        app:srcCompat="@drawable/ic_place"
        app:tint="?attr/colorTertiary" />

    <ImageView
        android:id="@+id/ghim1IV"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/a22_diem_dung"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40"
        app:srcCompat="@drawable/ic_place"
        app:tint="?attr/colorPrimary" />

    <ImageView
        android:id="@+id/ghim2IV"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/a22_diem_dung"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.24"
        app:srcCompat="@drawable/ic_place"
        app:tint="?attr/colorPrimary" />

    <ImageView
        android:id="@+id/ghim3IV"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/a22_diem_dung"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.80"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.16"
        app:srcCompat="@drawable/ic_place"
        app:tint="?attr/colorPrimary" />

    <!-- Thanh tên tour nổi trên bản đồ -->
    <LinearLayout
        android:id="@+id/thanhTrenLL"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_m"
        android:background="@drawable/bg_a22_o_trang"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/quayLaiIV"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a03_quay_lai"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tenTourTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Đà Lạt 3 ngày 2 đêm" />
    </LinearLayout>

    <!-- Chọn ngày để xem các điểm dừng -->
    <HorizontalScrollView
        android:id="@+id/chipHSV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thanhTrenLL">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ngayCG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/tatCaChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/a22_tat_ca" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ngay1Chip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/a22_ngay_1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ngay2Chip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/a22_ngay_2" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ngay3Chip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/a22_ngay_3" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <ImageView
        android:id="@+id/dinhViIV"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_tron_trang"
        android:contentDescription="@string/a22_vi_tri_cua_toi"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bangDuoiLL"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="?attr/colorOnSurface" />

    <!-- Khối thông tin sát đáy: ngày đang chọn, các điểm dừng, nút chỉ đường -->
    <LinearLayout
        android:id="@+id/bangDuoiLL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_a22_bang_duoi"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/colorOutline" />

        <TextView
            android:id="@+id/ngayTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Ngày 2" />

        <TextView
            android:id="@+id/tieuDeTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Đồi chè và thác Datanla" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/diemDungRV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            tools:itemCount="3"
            tools:listitem="@layout/item_a22_diem_dung" />

        <Button
            android:id="@+id/chiDuongBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:text="@string/a22_chi_duong"
            app:icon="@drawable/ic_map"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
