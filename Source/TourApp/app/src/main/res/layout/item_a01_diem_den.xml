<?xml version="1.0" encoding="utf-8"?>
<!-- Một ô điểm đến trong danh sách cuộn ngang của A01 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp">

    <ImageView
        android:id="@+id/anhIV"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_anh_trong"
        android:contentDescription="@string/a01_anh"
        android:padding="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_image"
        app:tint="?attr/colorOutline" />

    <TextView
        android:id="@+id/tenTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="@+id/anhIV"
        app:layout_constraintStart_toStartOf="@+id/anhIV"
        app:layout_constraintTop_toBottomOf="@+id/anhIV"
        tools:text="Đà Lạt" />

</androidx.constraintlayout.widget.ConstraintLayout>
