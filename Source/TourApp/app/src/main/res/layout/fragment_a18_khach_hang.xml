<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="@dimen/space_m">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tieuDeTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/e_title_khach_hang"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ô tìm kiếm -->
    <EditText
        android:id="@+id/timKiemET"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/bg_o_tim"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/space_s"
        android:hint="@string/e_tim_kiem_khach"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="@dimen/space_m"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tieuDeTV" />

    <!-- Chip lọc -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timKiemET">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTatCa"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/e_tat_ca" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHoatDong"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/e_hoat_dong" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBiKhoa"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/e_bi_khoa" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Số lượng khách hàng -->
    <TextView
        android:id="@+id/soKhachTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chipScroll"
        tools:text="9 khách hàng" />

    <!-- Danh sách khách hàng -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/khachHangRV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/soKhachTV"
        tools:listitem="@layout/item_a18_khach_hang" />

</androidx.constraintlayout.widget.ConstraintLayout>
