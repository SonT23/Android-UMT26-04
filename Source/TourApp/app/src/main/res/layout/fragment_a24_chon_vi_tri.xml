<?xml version="1.0" encoding="utf-8"?>
<!-- A24 Chọn vị trí trên bản đồ. Bản đồ thật (Google Maps, chức năng D8) làm ở tuần 9;
     giờ dùng một View nền xám chiếm cả màn hình làm hình giữ chỗ, ghim cố định ở giữa. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Chỗ của bản đồ -->
    <View
        android:id="@+id/banDoV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/banDoTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/a24_ban_do_giu_cho"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOutline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25" />

    <!-- Ô tìm bo tròn: nút quay lại và ô nhập địa chỉ -->
    <LinearLayout
        android:id="@+id/oTimLL"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_m"
        android:background="@drawable/bg_a24_o_tim"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/quayLaiIV"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a24_quay_lai"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/timET"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/a24_tim"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Dòng gợi ý phía trên ghim -->
    <TextView
        android:id="@+id/goiYTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_s"
        android:alpha="0.85"
        android:background="@drawable/bg_a24_goi_y"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/a24_goi_y"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorSurface"
        app:layout_constraintBottom_toTopOf="@+id/ghimIV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Ghim cố định giữa vùng bản đồ phía trên khối thông tin; người dùng kéo bản đồ chứ không kéo ghim -->
    <ImageView
        android:id="@+id/ghimIV"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/a24_ghim"
        app:layout_constraintBottom_toTopOf="@+id/khoiDuoiLL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/oTimLL"
        app:srcCompat="@drawable/ic_place"
        app:tint="?attr/colorPrimary" />

    <!-- Nút tròn về vị trí của tôi, nằm ngay trên khối thông tin -->
    <ImageView
        android:id="@+id/viTriCuaToiIV"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_tron_trang"
        android:contentDescription="@string/a24_vi_tri_cua_toi"
        android:elevation="2dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/khoiDuoiLL"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!-- Khối thông tin sát đáy -->
    <LinearLayout
        android:id="@+id/khoiDuoiLL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_a24_khoi_duoi"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Vạch nhỏ ở mép trên cho giống bảng trượt -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:alpha="0.4"
            android:background="?attr/colorOutline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/a24_vi_tri_diem_den"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tenViTriTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Đà Lạt, Lâm Đồng" />

        <TextView
            android:id="@+id/toaDoTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="11.9404, 108.4583" />

        <Button
            android:id="@+id/dungViTriBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/a24_dung_vi_tri" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
