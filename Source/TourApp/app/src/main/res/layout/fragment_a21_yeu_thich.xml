<?xml version="1.0" encoding="utf-8"?>
<!-- A21 Yêu thích và đã xem. Thanh điều hướng dưới KHÔNG nằm ở đây, nó thuộc KhachActivity. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/tieuDeTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/a21_tieu_de"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hai tab: mỗi tab gồm chữ và một gạch chân, tab đang chọn mới hiện gạch chân -->
    <LinearLayout
        android:id="@+id/tabLL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tieuDeTV">

        <LinearLayout
            android:id="@+id/yeuThichTabLL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/yeuThichTabTV"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary"
                tools:text="Yêu thích (3)" />

            <View
                android:id="@+id/yeuThichGachV"
                android:layout_width="64dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="?attr/colorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/daXemTabLL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/daXemTabTV"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="@string/a21_tab_da_xem"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:id="@+id/daXemGachV"
                android:layout_width="64dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="?attr/colorPrimary"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/duongKeV"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLL" />

    <!-- Dải báo mất mạng: ẩn khi chạy, hiện khi kiểm tra mạng (làm sau). tools:visibility chỉ để xem trước. -->
    <TextView
        android:id="@+id/matMangTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorTertiaryContainer"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="10dp"
        android:text="@string/a21_mat_mang"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duongKeV"
        tools:visibility="visible" />

    <!-- Nội dung tab "Yêu thích": danh sách tour đã lưu và dải tour đã xem -->
    <ScrollView
        android:id="@+id/yeuThichSV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/matMangTV">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_m">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/yeuThichRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                tools:itemCount="3"
                tools:listitem="@layout/item_a02_tour" />

            <TextView
                android:id="@+id/chuaCoYeuThichTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_l"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_l"
                android:text="@string/a21_chua_co_yeu_thich"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOutline"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/a21_da_xem_gan_day"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/xoaLichSuTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_xs"
                    android:text="@string/a21_xoa_lich_su"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daXemRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_xs"
                tools:listitem="@layout/item_a21_da_xem"
                tools:orientation="horizontal" />

            <TextView
                android:id="@+id/chuaXemTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_m"
                android:text="@string/a21_chua_xem"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOutline"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Nội dung tab "Đã xem gần đây": lưới 3 cột -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/daXemLuoiRV"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/matMangTV" />

</androidx.constraintlayout.widget.ConstraintLayout>
